# The quickspace shell: bar, launcher, notifications, tray watcher and polkit
# agent (SPEC.md §5.2-§5.4).
[Unit]
Description=quickspace shell
Documentation=https://github.com/mikelward/quickspace
# Scoped to the quickspace session. Plasma reaches graphical-session.target
# too, so this is never WantedBy= that.
PartOf=graphical-session.target
After=wayland-session@quickspace-hyprland.target graphical-session.target
# hypridle owns org.freedesktop.ScreenSaver, which apps must find already
# owned. Wants=, not Requires=: without hypridle the shell still starts, and
# `quickspace doctor` reports it.
Wants=hypridle.service
After=hypridle.service
# The owners the shell hosts exist before any autostarted app.
Before=xdg-desktop-autostart.target

[Service]
# Ready only once the shell reports that every owner it hosts is up
# (notifications, tray watcher, polkit agent), not when qs merely starts.
Type=notify
NotifyAccess=all
ExecStart=qs -c quickspace
TimeoutStartSec=15
Restart=on-failure
RestartSec=1
Slice=session-graphical.slice

[Install]
WantedBy=wayland-session@quickspace-hyprland.target
